# Write-scoped token — required only for `--push`. Reads of a public dataset work without it.
HF_TOKEN=

# Optional overrides (defaults shown).
# HF_RULES_REPO=Andwwy/rules
# HF_FILES_DIR=data
# HF_CLAUSES_DIR=clauses
# HF_FILES_TEXT_COLUMN=file
# CLAUSE_GRAMMAR=v2

# ── MotherDuck input source (optional; only for --motherduck) ──
# Read token from https://app.motherduck.com → Settings → Access Tokens
MOTHERDUCK_TOKEN=

# Optional overrides (defaults shown).
# MOTHERDUCK_DB=daily-extraction
# MD_FILES_TABLE=files
# Column mapping: canonical -> your table's column.
# MD_REPO_COLUMN=repo_name
# MD_PATH_COLUMN=file_path
# MD_LINK_COLUMN=source_url
# MD_SHA_COLUMN=content_hash
# MD_TEXT_COLUMN=content
# MD_STARS_COLUMN=          # empty -> stars defaults to 0
