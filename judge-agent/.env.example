# Copy to .env and fill in. .env is in .dockerignore so it never lands in the image.
PERPLEXITY_API_KEY=
MOTHERDUCK_TOKEN=
MOTHERDUCK_DB=rules_in_the_wild

# Hard cap. The agent persists running spend in crawl_settings.judge_spend_usd
# so a restart doesn't reset the meter. Delete the row to start a new budget
# window manually.
JUDGE_MAX_USD=1.00

# Override if you want to swap the model. Pricing constants in src/cost.py are
# tied to Haiku 4.5; bump them too if you switch.
JUDGE_MODEL=anthropic/claude-haiku-4-5
