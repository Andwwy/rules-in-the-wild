{
 "hooks": {
  "PreToolUse": [
   {"matcher": "Write|Edit|MultiEdit",
    "hooks": [{"type": "command", "command": "/usr/bin/python3 -I /opt/enforce/hooks/before_write.py", "timeout": 180}]}
  ],
  "PostToolUse": [
   {"matcher": "Bash",
    "hooks": [{"type": "command", "command": "/usr/bin/python3 -I /opt/enforce/hooks/after_bash.py", "timeout": 300}]}
  ],
  "Stop": [
   {"hooks": [{"type": "command", "command": "/usr/bin/python3 -I /opt/enforce/hooks/end_of_turn.py", "timeout": 180}]}
  ]
 }
}
