  "mechanism": {
   "enforcer": "Regex validator",
   "config": "enforcement/config/51-3.regex.json",
   "target": "code-file",
   "triggers": [
    "before-write",
    "after-edit",
    "end-of-turn"
   ],
   "why_enforcer_differs": "Implementer choice: comments are not syntax-tree nodes in Semgrep, so a Semgrep rule can only be a regex over the raw text, which cannot skip string literals that span lines (Python triple quotes, template literals) and so flags normal code (e.g. the glob \"./src/**/*.js\" in a config). The Regex validator reads the comments found by the toolbox's comment scanner, which skips strings first.",
   "translated_by": "Claude Code (local), Claude Opus 5.5, effort Extra"
  },
  "constraint_en": "Do not write any comments in any code file you generate."
 },
