# Copy to .env and fill in. .env is gitignored.
#
# PERPLEXITY_API_KEY is the only paid key needed for the prototype: it covers
# the Haiku judge via Perplexity's Agent API (anthropic/claude-haiku-4-5,
# no markup). Embeddings run locally (BAAI/bge-large-en-v1.5) — see
# src/embedder.py and the BGE-removal TODO before production.
PERPLEXITY_API_KEY=pplx-...

# Optional but recommended — unauthenticated GitHub API is rate-limited to 60 req/hr.
GITHUB_TOKEN=ghp_...

# Optional — when set, the crawler + admin both connect to MotherDuck's cloud
# DB instead of the local /data/rules.duckdb file. Get a service token at
# https://app.motherduck.com → Settings → Service tokens.
MOTHERDUCK_TOKEN=
MOTHERDUCK_DB=rules_in_the_wild
