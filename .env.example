# Sample .env — copy it to `.env` and fill in your own values. Every `.env` is git-ignored; never commit one.
#
# Each stage reads a `.env` from its own folder, so put the copy next to the stage you run:
#   assign+group/.env            the key of the provider you use (+ MOTHERDUCK_TOKEN for --from-db); the rule pipeline
#                                also reads every .env further up the tree, so one lab-wide file is enough
#   sem_filter/.env              PERPLEXITY_API_KEY
#   rule clause extraction/.env  MOTHERDUCK_TOKEN   (see its own .env.example for HF_TOKEN and the optional overrides)

# Perplexity — the model provider for the is_rule judge, and the rule pipeline's default (--provider perplexity)
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# OpenAI — rule pipeline --provider openai
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# AWS Bedrock — rule pipeline --provider bedrock. A Bedrock API key (Bedrock console → API keys); leave it empty to use
# the standard AWS credentials (~/.aws/credentials, AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or a role)
# Leave commented out unless you set a key: an empty AWS_BEARER_TOKEN_BEDROCK makes AWS tools send an empty
# token instead of signing with the access keys, and every Bedrock call fails.
# AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION_NAME=us-east-1
# The MTAC experiment gateway (experiment/scripts/gateway): your application inference profile for
# the experiment's model (Claude Haiku 4.5), tagged project=rules-in-the-wild and billing-tag1=<uni> (the lab account denies direct model calls),
# and the key the sandbox uses to call the gateway (any string; the default is sk-experiment-local)
BEDROCK_PROFILE_ARN=
GATEWAY_API_KEY=

# Budget in USD for every model call in rules in the wild (rule pipeline + MTAC experiment gateway).
# The ledger is rules in the wild/spend.jsonl; `python -m rule_pipeline.spend` prints the totals.
RITW_BUDGET_USD=50

# TypeSafe — Jev, for sem_filter/jev test (it also finds this key in any .env further up the tree)
# https://console.typesafe.ai/
TYPESAFE_API_KEY=

# MotherDuck — read rules from / load results to the `rules` database
# https://app.motherduck.com  →  Settings  →  Access Tokens   (a read token is enough for `--from-db`)
MOTHERDUCK_TOKEN=

# GitHub — for fetching rule files through the GitHub API at the higher, authenticated rate limit.
# A classic token with no scopes can read public repos.   https://github.com/settings/tokens
GH_TOKEN=
